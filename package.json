{
  "name": "dsh-plugin-conflict-audit",
  "version": "0.2.0",
  "description": "DSH 插件冲突审计：开机自检 + plugin_conflict_audit 工具。只读检测工具名撞车、patch 行 id 冲突、路由前缀重叠、技能重名、服务依赖缺失、版本兼容脱节。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "conflict",
    "audit",
    "diagnostics",
    "插件冲突",
    "诊断"
  ],
  "license": "MIT",
  "author": "www111-ui",
  "homepage": "https://github.com/www111-ui/dsh-plugin-conflict-audit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/www111-ui/dsh-plugin-conflict-audit.git"
  },
  "bugs": {
    "url": "https://github.com/www111-ui/dsh-plugin-conflict-audit/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-conflict-audit": "audit.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "audit.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.2-rc.1 <0.3.0-0"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1"
  },
  "scripts": {
    "audit": "node audit.mjs",
    "test": "node test/detector-test.mjs && node test/plugin-load-test.mjs"
  }
}
